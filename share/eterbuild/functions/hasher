load_mod rpm

set_hasherdir()
{
	HSH=/usr/bin/hsh
	if [ ! -x "$HSH" ] ; then
		fatal "Please install hasher package before use it"
	fi
	# Reuse the parent's directory even if loading userconfig reset HASHER_SLOT.
	if hasher_slot_inherited ; then
		HASHERDIR=$HASHER_LOCK_DIR
		return
	fi

	#if [ -n "$HASHERDIR" ] ; then
	#	fatal "Possible HASHERBASEDIR is not set correctly. Please replace HASHERDIR with HASHERBASEDIR in the config file"
	#fi
	HASHERDIR=$HASHERBASEDIR$MENVARG
	case "$BUILDARCH" in
		x86_64)  HASHERDIR="$HASHERDIR-64" ;;
		aarch64) HASHERDIR="$HASHERDIR-aarch64" ;;
	esac
	# Directory isolation only: hasher-priv selects its own free user pair.
	if [ "${HASHER_AUTO_SLOTS:-no}" != yes ] && [ -n "${HASHER_SLOT:-}" ] ; then
		fatal "Enable HASHER_AUTO_SLOTS=yes in configuration before selecting a slot"
	fi
	case "${HASHER_SLOT:-}" in
		*[!a-zA-Z0-9_-]*) fatal "Invalid HASHER_SLOT: use letters, digits, '_' or '-'" ;;
	esac
	[ -z "${HASHER_SLOT:-}" ] || HASHERDIR="$HASHERDIR-slot-$HASHER_SLOT"
}

hasher_slot_inherited()
{
	[ -n "${HASHER_LOCK_DIR:-}" ] &&
		[ "$HASHER_LOCK_DIR.ebu-lock" -ef /proc/self/fd/9 ]
}

# Hold fd 9 until the build and its installation helpers have all exited.
# The lock lives outside the chroot directory so cleanup cannot remove it.
acquire_hasher_slot()
{
	set_hasherdir
	hasher_slot_inherited && return
	command -v flock >/dev/null 2>&1 || fatal "Please install flock before using hasher"
	local base=$HASHERDIR slot=0 lock_status waited=
	mkdir -p "$(dirname "$base")" || fatal "Cannot create hasher parent directory"
	while : ; do
		exec 9>"$HASHERDIR.ebu-lock" || fatal "Cannot open hasher directory lock"
		# Explicit slots and operations on existing results must stay in place.
		if [ "${HASHER_AUTO_SLOTS:-no}" != yes ] ||
			[ -n "${HASHER_SLOT:-}" ] || [ "${1:-}" = fixed ] ; then
			flock 9 || fatal "Cannot lock hasher directory"
			break
		fi
		if flock -n 9 ; then
			break
		else
			lock_status=$?
		fi
		[ "$lock_status" = 1 ] || fatal "Cannot lock hasher directory"
		slot=$((slot + 1))
		# HASHER_MAX_SLOTS bounds parallel builds (the base dir counts as one): wait for a free one
		if [ -n "${HASHER_MAX_SLOTS:-}" ] && [ "$slot" -ge "$HASHER_MAX_SLOTS" ] ; then
			[ "$slot" -eq "$HASHER_MAX_SLOTS" ] && [ -z "$waited" ] && info "All $HASHER_MAX_SLOTS hasher slots are busy, waiting..."
			waited=1
			slot=0
			sleep 10
		fi
		[ "$slot" = 0 ] && HASHERDIR=$base || HASHERDIR=$base-slot-$slot
	done
	export HASHER_LOCK_DIR=$HASHERDIR
}


# hsh-mkchroot can fail at chgrp before creating .out or installing helpers.
# Preserve only that exact empty scaffold; never alter populated/unknown roots.
recover_incomplete_hasher_root()
(
	local root="$HASHERDIR/chroot" entry backup
	[ -d "$root" ] && [ ! -L "$root" ] && [ -O "$root" ] || return 0
	enable -f /usr/lib/bash/lockf lockf || fatal "Cannot load hasher directory lock"
	builtin lockf "$HASHERDIR" || fatal "Cannot lock hasher directory for recovery"
	# Recheck under hasher's native lock, also respected by direct hsh users.
	[ -d "$root" ] && [ ! -L "$root" ] && [ -O "$root" ] || return 0
	shopt -s dotglob nullglob
	local entries=("$root"/*)
	[ "${#entries[@]}" = 3 ] || return 0
	for entry in "${entries[@]}" ; do
		case "${entry##*/}" in .host|.in|dev) ;; *) return 0 ;; esac
		[ -d "$entry" ] && [ ! -L "$entry" ] && [ -O "$entry" ] || return 0
		local contents=("$entry"/*)
		[ "${#contents[@]}" = 0 ] || return 0
	done
	backup=$(mktemp -d "$HASHERDIR/chroot-incomplete.XXXXXX") || fatal "Cannot create recovery directory"
	mv -- "$root" "$backup/chroot" || fatal "Cannot preserve incomplete hasher root"
	warning "Preserved incomplete hasher root in $backup/chroot; initializing a new one" ||:
	return 0
)

# Cleanup a hasher work directory: remove chroot and aptbox (hsh --cleanup-only),
# keep the directory with its repo and cache. A directory in use (the build holds
# LOCK, by default DIR without -test plus .ebu-lock) is skipped, never waited for.
cleanup_hasher_dir()
(
	dir="$1"
	lock="${2:-${1%-test}.ebu-lock}"
	[ -d "$dir/chroot" ] || [ -d "$dir/aptbox" ] || [ -d "$dir/img-workdir" ] || return 0
	if [ -e "$lock" ] ; then
		exec 8<"$lock" || return 1
		if ! flock -n 8 ; then
			info "Skip $dir: it is in use"
			return 0
		fi
	fi
	echog "Cleanup hasher in $dir ..."
	docmd $HSH --cleanup-only --no-wait-lock "$dir"
)

