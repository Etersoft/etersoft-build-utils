# workaround about hard coded path to sources.list in apt.conf
print_tmp_aptconf()
{
	test -r "$1" || fatal "$1 is missed"
	# Note: /etc/apt and /etc/eterbuild/apt is supported
	cat "$1" | \
		sed -e "s|\"[^\"]*/sources\\.list[^\"]*\"|\"$OURSOURCES\"|g"
}

# printout sources.list with filtering from apt.conf
# workaround about hard coded arch in sources.list
print_tmp_sourceslist()
{
	local SLIST
	test -r "$1" || fatal "$1 is missed"
	# TODO add comments support
	# Note: /etc/apt and /etc/eterbuild/apt is supported
	if rhas "$1" "^/etc" ; then
		SLIST=`cat "$1" | \
			grep "/sources.list" | tail -n1 | sed -e 's|.*"\(.*\)".*|\1|g'`
	else
		SLIST=`cat "$1" | \
			sed -e "s|\"/etc/.*apt/sources.list|\"$ETERBUILDETC/apt/sources.list|g" | \
			grep "/sources.list" | tail -n1 | sed -e 's|.*"\(.*\)".*|\1|g'`
	fi
	[ -n "$SLIST" ] || SLIST="/etc/apt/sources.list"
	test -r "$SLIST" || fatal "'$SLIST' - sources.list path from $1 is missed"
	case "$BUILDARCH" in
		x86_64)
			cat "$SLIST" | sed -e "s|\([ /]\)i[56]86|\1$BUILDARCH|g"
			;;
		aarch64)
			# Replace i586/i686/x86_64 with aarch64, drop x86_64-i586 biarch suffix
			cat "$SLIST" | sed -e "s|\([ /]\)x86_64-i586|\1$BUILDARCH|g" -e "s|\([ /]\)i[56]86|\1$BUILDARCH|g" -e "s|\([ /]\)x86_64|\1$BUILDARCH|g"
			;;
		*)
			# Note: drop biarch 32bit on real 32bit
			cat "$SLIST" | sed -e "s|x86_64\([ /]\)|$BUILDARCH\1|g" -e "s|WINE/i586|WINE|" -e "s|WINE-Local/i586|WINE-Local|" -e "s|WINE-Network/i586|WINE-Network|" -e "s| i586/| |"  | grep -v "x86_32" | grep -v "x86_64-i586"
			;;
	esac
}

prepare_aptconfig()
{
	# Concurrent builds may use different architectures or extra repositories.
	OURSOURCES=$(make_temp_file sources.list) || fatal "Can't create sources.list"
	OURAPTCONF=$(make_temp_file apt.conf) || fatal "Can't create apt.conf"
	export OURSOURCES OURAPTCONF
	print_tmp_sourceslist "$APTCONF" >"$OURSOURCES" || fatal "Can't create sources.list"
	if [ -n "$ETERBUILD_APTREPO" ] ; then
		cat >>$OURSOURCES <<EOF

# Apply repo(s) from external ETERBUILD_APTREPO variable
$ETERBUILD_APTREPO
EOF
	fi
	print_tmp_aptconf "$APTCONF" >"$OURAPTCONF" || fatal "Can't create apt.conf"
	[ -n "$QUIETMODE" ] && return
	echo
	echog "Apt conf $APTCONF:"
	cat $APTCONF
	echo
	echog "Apt sources from $APTCONF:"
	cat $OURSOURCES | grep -v "^#" | grep -v "^\$" | grep rpm | sed -e "s|rpm|    rpm|"
	echo
}
