#: ../bin/rpmgp:260
msgid "   -d   download all matched packages"
msgstr "   -d   скачать все найденные пакеты"

#: ../bin/rpmgp:261
msgid "   -g   clone last built package repo"
msgstr "   -g   клонировать репозиторий последнего собранного пакета"

#: ../bin/rpmgp:262
msgid "   -gp  clone last built package repo via public access"
msgstr "   -gp  клонировать репозиторий пакета через публичный доступ"

#: ../bin/rpmgp:263
msgid "   -gm  remote clone repo to USER/packages and clone it locally"
msgstr "   -gm  удалённо клонировать репо в USER/packages и клонировать локально"

#: ../bin/rpmgp:264
msgid "   -m   migrate to gear from spec/srpm"
msgstr "   -m   миграция на gear из spec/srpm"

#: ../bin/rpmgp:267
msgid "   -i   install packages needed for build (use epm)"
msgstr "   -i   установить пакеты, необходимые для сборки (через epm)"

#: ../bin/rpmgp:268
msgid ""
"   -l   list packages needed for build (in local pkg system notation) "
"(experimental)"
msgstr ""
"   -l   вывести пакеты, необходимые для сборки (в нотации локальной системы "
"пакетов) (экспериментально)"

#: ../bin/rpmgp:269
msgid "   -r   refresh package list (download it again)"
msgstr "   -r   обновить список пакетов (скачать заново)"

#: ../bin/rpmgp:270
msgid "   -p   force use public access to the git repo"
msgstr "   -p   принудительно использовать публичный доступ к git-репозиторию"

#: ../bin/rpmgp:271
msgid "   -s   list all known remote repositories"
msgstr "   -s   вывести все известные удалённые репозитории"

#: ../bin/rpmgs:33
msgid "You can run 'rpmgs 1.2' for set new version 1.2 and download it"
msgstr "Можно запустить 'rpmgs 1.2' для установки новой версии 1.2 и её загрузки"

#: ../bin/rpmgs:34
msgid "Use HEAD instead version for get latest git commit"
msgstr "Используйте HEAD вместо версии для получения последнего коммита git"

#: ../bin/rpmgs:38
msgid ""
"   -f  force download and commit tarball(s) (remove source file before "
"download)"
msgstr ""
"   -f  принудительно скачать и закоммитить тарболл(ы) (удалить исходный файл "
"перед загрузкой)"

#: ../bin/rpmgs:295
msgid ""
"Can't find any spec file. It is possible you run this script not in git dir."
msgstr ""
"Не найден спек-файл. Возможно, скрипт запущен не в каталоге git."

#: ../bin/rpmgs:296
msgid "If you use old style build, run rpmgs with spec name as arg."
msgstr "При использовании старого стиля сборки укажите имя спека как аргумент."

#: ../bin/rpmgs:297
msgid "You can also use src.rpm URL in Source-url."
msgstr "Также можно использовать URL src.rpm в Source-url."

#: ../bin/rpmlog:13
msgid "rpmlog - update version/release and changelog"
msgstr "rpmlog - обновление версии/релиза и changelog"

#: ../bin/rpmlog:14
msgid ""
"Usage: rpmlog [-q] [-a|-r|-s|-v] [-l|-t] [-e [changelog entry]] [SPEC] "
"[fromTAG] [toTAG]"
msgstr ""
"Использование: rpmlog [-q] [-a|-r|-s|-v] [-l|-t] [-e [запись changelog]] [СПЕК] "
"[отTEG] [доTEG]"

#: ../bin/rpmlog:17
msgid ""
"   -a  increment version if code is changed or increment release if spec "
"changed only"
msgstr ""
"   -a  увеличить версию, если изменён код, или релиз, если изменён только спек"

#: ../bin/rpmlog:18
msgid "   -v  increment version"
msgstr "   -v  увеличить версию"

#: ../bin/rpmlog:19
msgid "   -r  increment release"
msgstr "   -r  увеличить релиз"

#: ../bin/rpmlog:20
msgid "   -s  increment subrelease"
msgstr "   -s  увеличить субрелиз"

#: ../bin/rpmlog:21
msgid "   -l  add changelog from git log (since last release tag or TAG)"
msgstr "   -l  добавить changelog из git log (с последнего тега релиза или TAG)"

#: ../bin/rpmlog:22
msgid "   -e  add (empty) changelog entry"
msgstr "   -e  добавить (пустую) запись в changelog"

#: ../bin/rpmlog:25
msgid "   -t  test run (without change files and repo)"
msgstr "   -t  тестовый запуск (без изменения файлов и репозитория)"

#: ../bin/rpmlog:26
msgid "   -o  print git log since last release tag or TAG"
msgstr "   -o  вывести git log с последнего тега релиза или TAG"

#: ../bin/rpmlog:27
msgid "   -q  quiet mode (do not ask anything)"
msgstr "   -q  тихий режим (ничего не спрашивать)"

#: ../bin/rpmlog:28
msgid "   -n VERSION  set version and reset release"
msgstr "   -n VERSION  установить версию и сбросить релиз"

#: ../bin/rpmlog:30
msgid "   --last-version    show current version of build"
msgstr "   --last-version    показать текущую версию сборки"

#: ../bin/rpmlog:31
msgid "   --last-changelog  show changelog the latest build"
msgstr "   --last-changelog  показать changelog последней сборки"

#: ../bin/rpmlog:33 ../bin/rpmrb:22
msgid "Example:"
msgstr "Пример:"

#: ../bin/rpmpub:21
msgid ""
"rpmpub - Etersoft specific script for publish gear repo to target ftp dir as "
"src.rpm"
msgstr ""
"rpmpub - скрипт Etersoft для публикации gear-репозитория на FTP как src.rpm"

#: ../bin/rpmpub:22
msgid "Usage: rpmpub [-f] [-B] [-r PROJECTVERSION ] [SPEC] [TARGETDIR]"
msgstr "Использование: rpmpub [-f] [-B] [-r ВЕРСИЯ ] [СПЕК] [КАТАЛОГ]"

#: ../bin/rpmpub:25
msgid "   -f                 force set tag"
msgstr "   -f                 принудительно установить тег"

#: ../bin/rpmpub:26
msgid "   -s                 skip set tag"
msgstr "   -s                 пропустить установку тега"

#: ../bin/rpmpub:27
msgid "   -B                 batch sign mode (for scripts without tty)"
msgstr "   -B                 пакетный режим подписи (для скриптов без tty)"

#: ../bin/rpmpub:28
msgid ""
"   -r PROJECTVERSION  set other project version (PROJECTVERSION/sources)"
msgstr ""
"   -r PROJECTVERSION  указать другую версию проекта (PROJECTVERSION/sources)"

#: ../bin/rpmpub:29
msgid ""
"   TARGETDIR          copy signed src.rpm package to TARGETDIR (f.i., /tmp/"
"some_version/sources)"
msgstr ""
"   TARGETDIR          скопировать подписанный src.rpm в TARGETDIR (напр., /tmp/"
"some_version/sources)"

#: ../bin/rpmpub:30
msgid "                      By default used path from Source: spec field. "
msgstr "                      По умолчанию используется путь из поля Source: спека. "

#: ../bin/rpmpub:31
msgid ""
"                      Also you can set default target dir in ETERDESTSRPM "
"variable."
msgstr ""
"                      Также можно задать каталог по умолчанию в переменной "
"ETERDESTSRPM."

#: ../bin/rpmrb:15
msgid ""
"rpmrb (Re Build) - update spec to vermajor.verminor version, build %rel "
"release"
msgstr ""
"rpmrb (Re Build) - обновить спек до версии vermajor.verminor, собрать "
"релиз %rel"

#: ../bin/rpmrb:16
msgid ""
"Usage: rpmrb [GIRAR] [-n] [-f] [-a TASK | -A] [spec] [vermajor][.verminor] "
"[rel]"
msgstr ""
"Использование: rpmrb [GIRAR] [-n] [-f] [-a TASK | -A] [спек] [vermajor][.verminor] "
"[rel]"

#: ../bin/rpmrb:17
msgid ""
"     -n      - skip install built package in hasher for testing purposes"
msgstr ""
"     -n      - пропустить установку собранного пакета в hasher для тестирования"

#: ../bin/rpmrb:18
msgid "     -f      - force tag overwrite"
msgstr "     -f      - принудительная перезапись тега"

#: ../bin/rpmrb:19
msgid "     -a TASK - add to existing (shared) task TASK after build"
msgstr "     -a TASK - добавить в существующую (общую) задачу TASK после сборки"

#: ../bin/rpmrb:20
msgid "     -A      - add to the last task after build"
msgstr "     -A      - добавить в последнюю задачу после сборки"

#: ../bin/rpmrb:88
msgid "Changelog entry already exists"
msgstr "Запись в changelog уже существует"

#: ../bin/rpmunmets:45
msgid " -s   - get all unmets"
msgstr " -s   - получить все неудовлетворённые зависимости"

#: ../bin/rpmurl:30
msgid "   -p  open package page on http://packages.altlinux.org"
msgstr "   -p  открыть страницу пакета на http://packages.altlinux.org"

#: ../bin/rpmurl:31
msgid "   -c  check if package URL is accessible"
msgstr "   -c  проверить доступность URL пакета"

#: ../bin/rpmurl:32
msgid "   -t  just print URL"
msgstr "   -t  только вывести URL"

#: ../bin/rpmurl:33
msgid ""
"   -s  open package source dir in the default browser (for spec / git repo "
"only"
msgstr ""
"   -s  открыть каталог исходников пакета в браузере (только для спека / "
"git-репозитория)"

#: ../bin/rpmurl:36
msgid "   -f  print failed URL only"
msgstr "   -f  выводить только недоступные URL"

